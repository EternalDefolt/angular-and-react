<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ReactRoot>ClientApp\react\</ReactRoot>
    <AngularRoot>ClientApp\angular\</AngularRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\**;wwwroot\react\**;wwwroot\angular\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.2" />
  </ItemGroup>

  <Target Name="BuildReact" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(ReactRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(ReactRoot)" Command="npm run build" />
  </Target>

  <Target Name="BuildAngular" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(AngularRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(AngularRoot)" Command="npx ng build --configuration production" />
  </Target>

  <Target Name="PublishClients" AfterTargets="ComputeFilesToPublish" DependsOnTargets="BuildReact;BuildAngular">
    <ItemGroup>
      <ClientDistFiles Include="wwwroot\react\**;wwwroot\angular\**" />
      <ResolvedFileToPublish Include="@(ClientDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>%(ClientDistFiles.Identity)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
